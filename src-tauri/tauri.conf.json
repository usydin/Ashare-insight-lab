{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "A股智研台",
  "version": "0.5.0",
  "identifier": "com.block10studio.ashareinsightlab",
  "build": {
    "beforeDevCommand": "cd ../frontend-react && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "cd ../frontend-react && npm run build",
    "frontendDist": "../frontend-react/dist"
  },
  "app": {
    "windows": [
      {
        "title": "A股智研台 | AShare Insight Lab",
        "width": 1360,
        "height": 860,
        "minWidth": 1180,
        "minHeight": 760,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
